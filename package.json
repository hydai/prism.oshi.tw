{
  "name": "prism-oshi-tw",
  "version": "1.0.0",
  "description": "Multi-streamer music archive platform",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"app/**/*.test.ts\" \"app/**/*.test.tsx\"",
    "test:youtube-iframe-types": "npx tsc --noEmit --pretty false --skipLibCheck --strict --target ES2017 --module esnext --moduleResolution bundler --lib dom,dom.iterable,esnext --types node lib/youtube-iframe.test.ts",
    "test:aurora-nova": "npx tsx tools/aurora/tests/nova.test.ts",
    "test:browser-storage": "npx tsx tools/browser-storage.test.ts && npx tsx admin/ui/tests/streams-filter.test.ts",
    "test:turnstile": "npx tsx tools/turnstile.test.ts",
    "test:shared-web": "npx tsx tools/shared/web/html.test.ts && npx tsx tools/shared/web/theme.test.ts && npx tsx tools/shared/web/page-shell.test.ts && npx tsx tools/shared/web/json-body.test.ts",
    "test:deploy-workflow-permissions": "npx tsx tools/deploy-workflow-permissions.test.ts",
    "inbox:status": "npx tsx tools/inbox-status/status.ts",
    "inbox:status:test": "npx tsx tools/inbox-status/status.test.ts",
    "sync:registry": "npx tsx tools/sync-registry/sync.ts",
    "sync:data": "npx tsx tools/sync-data/sync.ts",
    "sync:status": "npx tsx tools/sync-status/sync.ts",
    "sync:stale": "npx tsx tools/sync-stale/sync.ts",
    "fetch:channel-info": "npx tsx tools/fetch-channel-info/fetch.ts",
    "fetch:channel-info:test": "npx tsx tools/fetch-channel-info/fetch.test.ts",
    "test:announce": "npx tsx tools/shared/announce.test.ts",
    "test:slug": "npx tsx tools/shared/slug.test.ts",
    "test:cli": "npx tsx tools/shared/cli.test.ts",
    "test:d1": "npx tsx tools/shared/d1.test.ts",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "sync:registry:test": "npx tsx tools/sync-registry/sync.test.ts",
    "sync:data:test": "npx tsx tools/sync-data/sync.test.ts",
    "sync:status:test": "npx tsx tools/sync-status/detect.test.ts",
    "announce:flush": "npx tsx tools/announce-flush/flush.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.25",
    "lucide-react": "^0.564.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
