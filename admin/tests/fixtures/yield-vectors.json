    "submitted": [
      { "title": "First", "artist": "A", "start": 100, "end": 200 },
      { "title": "Song B", "artist": "B", "start": 200, "end": null }
    ],
    "ends": [300, null]
  },
  {
    "name": "a new row inserted into a gap keeps the fill before it, and the row after it takes back its end",
