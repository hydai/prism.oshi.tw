[
  {
    "name": "a boundary moved earlier keeps the end it was given: the next row moved, and the archived end passes its start",
    "archived": [
      { "title": "First", "artist": "A", "start": 100, "end": 200 },
      { "title": "Second", "artist": "B", "start": 200, "end": 300 }
    ],
    "submitted": [
      { "title": "First", "artist": "A", "start": 100, "end": 170 },
      { "title": "Second", "artist": "B", "start": 170, "end": 300 }
    ],
    "ends": [170, 300]
  },
  {
    "name": "a boundary moved later gives the archived end back, leaving a gap",
    "archived": [
      { "title": "First", "artist": "A", "start": 100, "end": 200 },
      { "title": "Second", "artist": "B", "start": 200, "end": 300 }
    ],
    "submitted": [
      { "title": "First", "artist": "A", "start": 100, "end": 230 },
      { "title": "Second", "artist": "B", "start": 230, "end": 300 }
    ],
    "ends": [200, 300]
  },
  {
    "name": "a start-only paste moving Second before First's archived end keeps the parser's end",
    "archived": [
      { "title": "First", "artist": "A", "start": 100, "end": 200 },
      { "title": "Second", "artist": "B", "start": 300, "end": 400 }
    ],
    "submitted": [
      { "title": "First", "artist": "A", "start": 100, "end": 150 },
      { "title": "Second", "artist": "B", "start": 150, "end": null }
    ],
    "ends": [150, null]
  },
  {
    "name": "a contiguous end typed alone reads as the fill: the archived end comes back",
    "archived": [
      { "title": "First", "artist": "A", "start": 100, "end": 150 },
      { "title": "Second", "artist": "B", "start": 200, "end": 300 }
    ],
    "submitted": [
      { "title": "First", "artist": "A", "start": 100, "end": 200 },
      { "title": "Second", "artist": "B", "start": 200, "end": 300 }
    ],
    "ends": [150, 300]
  },
  {
    "name": "an unchanged start-only paste of an overlapping archive: the next row starts where an archived row does, so the archived ends come back",
    "archived": [
      { "title": "First", "artist": "A", "start": 100, "end": 300 },
      { "title": "Second", "artist": "B", "start": 200, "end": 400 }
    ],
    "submitted": [
      { "title": "First", "artist": "A", "start": 100, "end": 200 },
      { "title": "Second", "artist": "B", "start": 200, "end": null }
    ],
    "ends": [300, 400]
  },
  {
    "name": "a next row renamed at its archived start is not moved: the archived end comes back",
    "archived": [
      { "title": "First", "artist": "A", "start": 100, "end": 300 },
      { "title": "Snog B", "artist": "B", "start": 200, "end": 400 }
