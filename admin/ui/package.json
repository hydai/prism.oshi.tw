{
  "name": "prism-admin-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src tests",
    "lint:compiler": "eslint --config eslint.compiler.config.mjs --no-config-lookup src tests",
    "check": "npm run lint && npm run test:api-resource && npm run test:numeric-input && npm run test:youtube-embed && npm run test:crystal-tickets && npm run test:pipeline-extract-state && npm run test:work-review && npm run test:nova-links && npm run test:stream-detail && npm run test:toast && npm run test:stamp-editor && npm run test:player-clock && npm run test:player-clock-isolation && npm run test:song-table-memo && npm run test:vod-export && npm run test:prism-components && npm run test:nova-vod-groups && npm run test:nova-vod-row && npm run test:status-totals && npm run test:row-action-errors && npm run test:review-list-filters && npm run test:format-timestamp && npm run test:table-shells && npm run test:row-drafts && npm run test:harmonize-scan && npm run test:harmonizer-work-id && npm run test:streams-filter && npm run test:streams-render && npm run test:global-works && npm run test:loading-state && npm run test:search-param-state && npm run test:streamer-store && npm run test:route-manifest && npm run typecheck:tests && npm run build",
    "test:api-resource": "npx tsx --tsconfig tsconfig.tests.json tests/api-resource.test.ts",
    "test:prism-components": "npx tsx --tsconfig tsconfig.tests.json tests/prism-components.test.tsx",
    "test:nova-vod-groups": "npx tsx --tsconfig tsconfig.tests.json tests/nova-vod-groups.test.ts",
    "test:numeric-input": "npx tsx --tsconfig tsconfig.tests.json tests/numeric-input.test.ts",
    "test:youtube-embed": "npx tsx --tsconfig tsconfig.tests.json tests/youtube-embed.test.tsx",
    "test:crystal-tickets": "npx tsx --tsconfig tsconfig.tests.json tests/crystal-tickets-ui.test.tsx",
    "test:pipeline-extract-state": "npx tsx --tsconfig tsconfig.tests.json tests/pipeline-extract-state.test.ts",
    "test:nova-links": "npx tsx --tsconfig tsconfig.tests.json tests/nova-submissions-links.test.tsx",
    "test:stream-detail": "npx tsx --tsconfig tsconfig.tests.json tests/stream-detail-ui.test.tsx",
    "test:toast": "npx tsx --tsconfig tsconfig.tests.json tests/toast.test.tsx",
    "test:stamp-editor": "npx tsx --tsconfig tsconfig.tests.json tests/stamp-editor-ui.test.tsx",
    "test:player-clock": "npx tsx --tsconfig tsconfig.tests.json tests/player-clock.test.ts",
    "test:player-clock-isolation": "npx tsx --tsconfig tsconfig.tests.json tests/player-clock-isolation.test.tsx",
    "test:song-table-memo": "npx tsx --tsconfig tsconfig.tests.json tests/song-table-memo.test.tsx",
    "test:streams-filter": "npx tsx --tsconfig tsconfig.tests.json tests/streams-filter.test.ts",
    "test:streams-render": "npx tsx --tsconfig tsconfig.tests.json tests/streams-list-render.test.tsx",
    "test:global-works": "npx tsx --tsconfig tsconfig.tests.json tests/global-works-ui.test.tsx",
    "test:work-review": "npx tsx --tsconfig tsconfig.tests.json tests/work-review-ui.test.tsx",
    "test:harmonizer-work-id": "npx tsx --tsconfig tsconfig.tests.json tests/harmonizer-work-id.test.tsx",
    "test:loading-state": "npx tsx --tsconfig tsconfig.tests.json tests/loading-state.test.ts",
    "test:vod-export": "npx tsx --tsconfig tsconfig.tests.json tests/vod-export-ui.test.tsx",
    "preview": "vite preview",
    "test:nova-vod-row": "npx tsx --tsconfig tsconfig.tests.json tests/nova-vod-row.test.tsx",
    "test:status-totals": "npx tsx --tsconfig tsconfig.tests.json tests/status-totals.test.ts",
    "test:row-action-errors": "npx tsx --tsconfig tsconfig.tests.json tests/row-action-errors.test.ts",
    "test:review-list-filters": "npx tsx --tsconfig tsconfig.tests.json tests/review-list-filters.test.ts",
    "test:format-timestamp": "npx tsx --tsconfig tsconfig.tests.json tests/format-timestamp.test.ts",
    "test:table-shells": "npx tsx --tsconfig tsconfig.tests.json tests/table-shells.test.tsx",
    "test:row-drafts": "npx tsx --tsconfig tsconfig.tests.json tests/row-drafts.test.tsx",
    "test:harmonize-scan": "npx tsx --tsconfig tsconfig.tests.json tests/harmonize-scan.test.tsx",
    "test:search-param-state": "npx tsx --tsconfig tsconfig.tests.json tests/search-param-state.test.tsx",
    "test:streamer-store": "npx tsx --tsconfig tsconfig.tests.json tests/streamer-store.test.tsx",
    "test:route-manifest": "npx tsx --tsconfig tsconfig.tests.json tests/route-manifest.test.tsx",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-hooks-v7": "npm:eslint-plugin-react-hooks@7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "20.13.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3"
  }
}
