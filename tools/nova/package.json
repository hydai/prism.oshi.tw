{
  "name": "oshi-prism-nova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx wrangler@latest dev",
    "deploy": "npx wrangler@latest deploy",
    "db:create": "npx wrangler@latest d1 create oshi-prism-nova",
    "db:migrate": "npx wrangler@latest d1 execute oshi-prism-nova --file=schema.sql",
    "db:migrate:local": "npx wrangler@latest d1 execute oshi-prism-nova --local --file=schema.sql",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:origins": "npx tsx src/origins.test.ts",
    "test:video-info": "npx tsx src/index.test.ts",
    "test:vod-page": "npx tsx src/vod-page.test.ts",
    "test:channel-info": "npx tsx src/channel-info.workerd.test.ts",
    "check": "npm run typecheck && npm run test:theme && npm run test:status-page && npm run test:page && npm run test:origins && npm run test:video-info && npm run test:vod-page && npm run test:validate && npm run test:submit-limits && npm run test:channel-info",
    "test:theme": "npx tsx src/theme.test.ts",
    "test:status-page": "npx tsx src/status-page.test.ts",
    "test:page": "npx tsx src/page.test.ts",
    "test:validate": "npx tsx src/validate.test.ts",
    "test:submit-limits": "npx tsx src/submit-limits.test.ts"
  },
  "dependencies": {
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "wrangler": "4.128.0"
  }
}
