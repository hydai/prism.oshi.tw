{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "es2022",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "shared/**/*.ts",
    "sync-*/**/*.ts",
    "inbox-status/**/*.ts",
    "fetch-channel-info/**/*.ts",
    "announce-flush/**/*.ts",
    "csp-browser-check.ts"
  ],
  "exclude": ["nova", "crystal", "aurora", "**/node_modules"]
}
