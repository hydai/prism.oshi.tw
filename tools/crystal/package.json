{
  "name": "oshi-prism-crystal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx wrangler@latest dev",
    "deploy": "npx wrangler@latest deploy",
    "db:create": "npx wrangler@latest d1 create oshi-crystal",
    "db:migrate": "npx wrangler@latest d1 execute oshi-crystal --file=schema.sql",
    "db:migrate:local": "npx wrangler@latest d1 execute oshi-crystal --local --file=schema.sql",
    "test": "tsx src/validate.test.ts && tsx src/qa-page.test.ts && tsx src/similar.test.ts && tsx src/qa-api.test.ts && tsx src/theme.test.ts && tsx src/form-page.test.ts && tsx src/submit-guard.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
